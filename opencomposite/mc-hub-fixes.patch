@@ -22,6 +22,7 @@
 
 static XrBackend* currentBackend;
 static bool initialised = false;
+static bool noHmd = false; // MC-challenge-HUB patch: last init failed because no headset is there
 
 #ifdef _WIN32
 std::string GetExeName()
@@ -77,6 +78,20 @@ static XrBool32 XRAPI_CALL debugCallback(
 }
 #endif
 
+// MC-challenge-HUB patch: like CreateSystemID, but returns the result instead of aborting
+static XrResult TryCreateSystemID()
+{
+	XrSystemGetInfo systemInfo{};
+	systemInfo.type = XR_TYPE_SYSTEM_GET_INFO;
+	systemInfo.formFactor = XR_FORM_FACTOR_HEAD_MOUNTED_DISPLAY;
+	return xrGetSystem(xr_instance, &systemInfo, &xr_system);
+}
+
+bool DrvOpenXR::LastInitNoHmd()
+{
+	return noHmd;
+}
+
 static void CreateSystemID()
 {
 	// Create a system - this is when we choose what form factor we want, in this case an HMD
@@ -279,7 +294,20 @@ IBackend* DrvOpenXR::CreateOpenXRBackend(const char* startupInfo)
 	// Load the function pointers for the extension functions
 	xr_ext = new XrExt(apiFlags, extensions);
 
-	CreateSystemID();
+	// MC-challenge-HUB patch: without a headset (Quest not connected) the runtime answers
+	// XR_ERROR_FORM_FACTOR_UNAVAILABLE. Aborting here kills the whole game; SteamVR instead reports
+	// VRInitError_Init_HmdNotFound and the game goes on without VR. Do the same: clean up and fail the init.
+	noHmd = false;
+	if (XrResult res = TryCreateSystemID(); XR_FAILED(res)) {
+		OOVR_LOGF("No headset available (XrResult %d), VR init fails without aborting", res);
+		noHmd = true;
+		delete xr_ext;
+		xr_ext = nullptr;
+		xrDestroyInstance(xr_instance);
+		xr_instance = XR_NULL_HANDLE;
+		initialised = false;
+		return nullptr;
+	}
 
 	// List off the views and store them locally for easy access
 	uint32_t viewCount = 0;
